/* ===== Design Tokens =====
   深色主题性格测试应用。语义色彩：text-primary 用于正文（对比度>=4.5:1），
   text-secondary 用于辅助信息，accent 用于品牌强调。触控目标统一 88rpx，
   动效统一 200ms，尊重 reduced-motion。 */

page {
  background: #0f0f1a;
  color: #f5f5f7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

.container {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== Typography ===== */
.t-hero    { font-size: 48rpx; font-weight: 700; letter-spacing: 2rpx; }
.t-heading { font-size: 32rpx; font-weight: 600; }
.t-body    { font-size: 28rpx; line-height: 1.6; color: #c8c8d4; }
.t-caption { font-size: 24rpx; color: #a8a8b8; }
.t-label   { font-size: 22rpx; color: #a8a8b8; text-transform: uppercase; letter-spacing: 2rpx; }

/* ===== Buttons ===== */
.btn-primary {
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  padding: 28rpx 64rpx;
  font-size: 30rpx;
  font-weight: 600;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 200ms ease-out, transform 200ms ease-out;
}
.btn-primary::after { border: none; }
.btn-primary:active { opacity: 0.82; transform: scale(0.97); }

.btn-outline {
  background: transparent;
  color: #a29bfe;
  border: 2rpx solid rgba(162,155,254,0.4);
  border-radius: 48rpx;
  padding: 26rpx 64rpx;
  font-size: 30rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 200ms ease-out;
}
.btn-outline::after { border: none; }
.btn-outline:active { background: rgba(162,155,254,0.08); }

.btn-ghost {
  background: transparent;
  color: #a8a8b8;
  border: none;
  font-size: 28rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color 200ms ease-out;
}
.btn-ghost::after { border: none; }
.btn-ghost:active { color: #a8a8b8; }

/* ===== Cards ===== */
.card {
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 16rpx;
  padding: 32rpx;
  transition: border-color 200ms ease-out;
}

.card-elevated {
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 20rpx;
  padding: 32rpx;
}

/* ===== Surface hierarchy ===== */
.surface-base  { background: rgba(255,255,255,0.02); }
.surface-card  { background: rgba(255,255,255,0.04); }
.surface-raised { background: rgba(255,255,255,0.06); }

/* ===== Dividers ===== */
.divider {
  height: 1rpx;
  background: rgba(255,255,255,0.08);
  margin: 32rpx 0;
}

/* ===== Loading ===== */
.skeleton {
  background: linear-gradient(90deg, rgba(255,255,255,0.04), rgba(255,255,255,0.08), rgba(255,255,255,0.04));
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

.spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid rgba(255,255,255,0.08);
  border-top-color: #a29bfe;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}
.loading-text {
  color: #a8a8b8;
  font-size: 28rpx;
  margin-top: 24rpx;
}

/* ===== Utilities ===== */
.text-center { text-align: center; }
.text-accent { color: #a29bfe; }
.text-dim    { color: #a8a8b8; }
.mt-8  { margin-top: 8rpx; }  .mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }  .mt-32 { margin-top: 32rpx; }
.mt-48 { margin-top: 48rpx; }
.mb-16 { margin-bottom: 16rpx; } .mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.gap-16 { gap: 16rpx; } .gap-24 { gap: 24rpx; }

/* ===== Scrollbar ===== */
::-webkit-scrollbar { width: 0; height: 0; }

/* 尊重系统减少动效设置 */
@media (prefers-reduced-motion: reduce) {
  .btn-primary, .btn-outline, .btn-ghost,
  .skeleton, .spinner {
    animation: none !important;
    transition: none !important;
  }
}

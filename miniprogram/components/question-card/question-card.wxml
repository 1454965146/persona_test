<view class="card">
  <view class="card-header"><text class="card-num">第 {{index + 1}} 题</text></view>
  <text class="card-question">{{question.text}}</text>
  <view class="likert">
    <view class="likert-option {{selected === item.val ? 'active' : ''}}" wx:for="{{options}}" wx:key="val" data-val="{{item.val}}" bindtap="onSelect">
      <text class="likert-circle">{{selected === item.val ? '●' : '○'}}</text>
      <text class="likert-label">{{item.label}}</text>
    </view>
  </view>
</view>
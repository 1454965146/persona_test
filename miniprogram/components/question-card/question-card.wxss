.card{background:rgba(255,255,255,0.04);border:1rpx solid rgba(255,255,255,0.08);border-radius:20rpx;padding:40rpx;margin:24rpx 0}
.card-header{margin-bottom:24rpx}
.card-num{font-size:24rpx;color:#c9bdff;background:rgba(108,92,231,0.15);padding:6rpx 20rpx;border-radius:20rpx}
.card-question{display:block;font-size:34rpx;line-height:1.6;color:#f5f5f7;margin-bottom:40rpx}
.likert{display:flex;justify-content:space-between;gap:8rpx}
.likert-option{display:flex;flex-direction:column;align-items:center;padding:16rpx 0;min-height:88rpx;transition:transform 200ms ease-out}
.likert-option:active{transform:scale(0.94)}
.likert-circle{font-size:40rpx;color:#7a7a8a;margin-bottom:8rpx;transition:color 200ms ease-out}
.likert-option.active .likert-circle{color:#a29bfe}
.likert-label{font-size:20rpx;color:#a8a8b8;white-space:nowrap;transition:color 200ms ease-out}
.likert-option.active .likert-label{color:#c9bdff;font-weight:600}

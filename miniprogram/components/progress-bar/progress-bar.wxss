.progress-wrap{display:flex;align-items:center;gap:20rpx;padding:20rpx 0}
.progress-bg{flex:1;height:8rpx;background:rgba(255,255,255,0.1);border-radius:4rpx;overflow:hidden}
.progress-fill{height:100%;background:linear-gradient(90deg,#6c5ce7,#a29bfe);border-radius:4rpx;transition:width 200ms ease-out}
.progress-text{font-size:24rpx;color:#a8a8b8;min-width:80rpx;text-align:right}

.compare-body{padding-bottom:48rpx}
.vs-header{display:flex;align-items:center;justify-content:center;padding:32rpx 8rpx;gap:0}
.vs-card{flex:1;text-align:center}
.vs-type{display:inline-block;font-size:36rpx;font-weight:800;color:#a29bfe;
  background:rgba(108,92,231,0.12);padding:8rpx 28rpx;border-radius:20rpx;letter-spacing:4rpx}
.vs-name{display:block;font-size:28rpx;color:#c8c8d4;margin-top:12rpx}
.vs-divider{width:64rpx;text-align:center}
.vs-text{font-size:40rpx;font-weight:900;color:#6c5ce7}

.section{padding:12rpx 0 20rpx}
.section-title{display:flex;align-items:center;font-size:30rpx;font-weight:600;color:#f5f5f7;margin-bottom:24rpx}
.section-marker{width:6rpx;height:28rpx;border-radius:3rpx;background:linear-gradient(180deg,#6c5ce7,#a29bfe);margin-right:14rpx}

.radar-legend{display:flex;justify-content:center;gap:40rpx;margin-top:16rpx}
.legend-item{display:flex;align-items:center;gap:8rpx;font-size:24rpx;color:#a8a8b8}
.legend-dot{width:16rpx;height:16rpx;border-radius:50%}

.dim-compare{display:flex;flex-direction:column;gap:14rpx}
.dim-compare-row{display:flex;align-items:center;gap:12rpx}
.dim-compare-label{width:120rpx;font-size:24rpx;color:#a8a8b8}
.dim-compare-bars{flex:1;display:flex;align-items:center;gap:8rpx}
.dim-compare-val{font-size:22rpx;font-weight:600;width:36rpx;text-align:center}
.dim-compare-val.a{color:#a29bfe}
.dim-compare-val.b{color:#fd79a8}
.dim-compare-bar-wrap{flex:1;height:10rpx;background:rgba(255,255,255,0.08);border-radius:5rpx;overflow:hidden}
.dim-compare-bar{height:100%;border-radius:5rpx;transition:width 1s ease}

.match-card{display:flex;flex-direction:column;align-items:center;padding:16rpx 0 8rpx}
.match-desc{font-size:24rpx;color:#a8a8b8;margin-top:20rpx;text-align:center}

.report-card{background:rgba(255,255,255,0.03);border:1rpx solid rgba(255,255,255,0.08);
  border-radius:16rpx;padding:32rpx;line-height:1.8}
.report-card h2{font-size:32rpx;color:#c9bdff;margin:24rpx 0 12rpx}
.report-card h3{font-size:28rpx;color:#f5f5f7;margin:20rpx 0 8rpx}
.report-card blockquote{border-left:4rpx solid #6c5ce7;padding-left:20rpx;color:#a8a8b8;margin:16rpx 0}
.report-card p{margin:8rpx 0;font-size:27rpx;color:#c8c8d4}

.spinner{width:48rpx;height:48rpx;border:4rpx solid rgba(255,255,255,0.1);border-top-color:#a29bfe;
  border-radius:50%;animation:spin 0.8s linear infinite;margin:0 auto 24rpx}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-text{font-size:28rpx;color:#a29bfe;display:block;text-align:center}
.loading-wrap{padding:160rpx 0;text-align:center}

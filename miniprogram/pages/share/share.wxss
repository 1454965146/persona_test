.share-hero { text-align: center; padding: 72rpx 0 40rpx; }
.share-mark {
  width: 100rpx; height: 100rpx; margin: 0 auto 24rpx;
  border-radius: 50%; background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  display: flex; align-items: center; justify-content: center;
}
.share-mark-text { font-size: 44rpx; font-weight: 700; color: #fff; }
.share-title { display: block; font-size: 36rpx; font-weight: 600; color: #f5f5f7; margin-bottom: 12rpx; }
.share-subtitle { display: block; font-size: 28rpx; color: #a29bfe; margin-bottom: 16rpx; }
.share-type-badge {
  display: inline-block; font-size: 22rpx; color: #a29bfe;
  background: rgba(108,92,231,0.15); padding: 6rpx 24rpx; border-radius: 20rpx;
  letter-spacing: 3rpx;
}

.error-card {
  background: rgba(255,107,107,0.08); border: 1rpx solid rgba(255,107,107,0.2);
  border-radius: 14rpx; padding: 24rpx; margin-bottom: 32rpx;
}
.error-text { font-size: 26rpx; color: #ff6b6b; display: block; text-align: center; }

.input-group { margin-bottom: 32rpx; }
.input-label { display: block; font-size: 24rpx; color: #a8a8b8; letter-spacing: 2rpx; margin-bottom: 12rpx; }
.input-field {
  background: rgba(255,255,255,0.06); border: 2rpx solid rgba(255,255,255,0.08);
  border-radius: 16rpx; padding: 28rpx 24rpx; color: #f0f0f5; font-size: 30rpx;
  text-align: center; min-height: 88rpx; box-sizing: border-box;
  transition: border-color 200ms ease-out;
}
.input-field:focus { border-color: #6c5ce7; }
.input-placeholder { color: #7a7a8a; }

.hint-text { display: block; text-align: center; font-size: 24rpx; color: #7a7a8a; margin-top: 24rpx; }

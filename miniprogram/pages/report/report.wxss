/* Hero */
.hero-card{text-align:center;padding:40rpx 0 24rpx}
.type-ring{display:inline-flex;align-items:center;justify-content:center;width:160rpx;height:160rpx;
  border-radius:50%;background:linear-gradient(135deg,rgba(108,92,231,0.2),rgba(162,155,254,0.1));
  border:3rpx solid rgba(162,155,254,0.3);margin-bottom:20rpx}
.type-badge{font-size:52rpx;font-weight:800;color:#a29bfe;letter-spacing:6rpx}
.hero-name{display:block;font-size:36rpx;font-weight:600;color:#fff;margin-bottom:8rpx}
.hero-subtitle{display:block;font-size:26rpx;color:#a8a8b8}

/* Sections */
.section{padding:12rpx 0 32rpx}
.section-title{display:flex;align-items:center;font-size:30rpx;font-weight:600;color:#f5f5f7;margin-bottom:24rpx}
.section-marker{width:6rpx;height:28rpx;border-radius:3rpx;background:linear-gradient(180deg,#6c5ce7,#a29bfe);margin-right:14rpx}
.radar-section{display:flex;flex-direction:column;align-items:center}

/* Dimension cards */
.dim-cards{display:flex;flex-direction:column;gap:16rpx}
.dim-card{background:rgba(255,255,255,0.04);border-radius:16rpx;padding:24rpx;
  border:1rpx solid rgba(255,255,255,0.08)}
.dim-card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10rpx}
.dim-card-label{font-size:26rpx;color:#c8c8d4}
.dim-card-score{font-size:30rpx;font-weight:700;color:#f5f5f7}
.dim-card-unit{font-size:22rpx;color:#a8a8b8;font-weight:400}
.dim-card-bar-wrap{height:10rpx;background:rgba(255,255,255,0.08);border-radius:5rpx;overflow:hidden}
.dim-card-bar{height:100%;border-radius:4rpx;transition:width 0.8s ease}

/* Report content */
.report-card{background:rgba(255,255,255,0.03);border:1rpx solid rgba(255,255,255,0.08);
  border-radius:16rpx;padding:32rpx;line-height:1.8}
.report-card h2{font-size:32rpx;color:#c9bdff;margin:24rpx 0 12rpx}
.report-card h3{font-size:28rpx;color:#f5f5f7;margin:20rpx 0 8rpx}
.report-card blockquote{border-left:4rpx solid #6c5ce7;padding-left:20rpx;color:#a8a8b8;margin:16rpx 0}
.report-card p{margin:8rpx 0;font-size:27rpx;color:#c8c8d4}
.report-card b{color:#fff}

/* Actions */
.actions{padding:24rpx 0 48rpx}
.share-btn{width:100%;display:flex;align-items:center;justify-content:center}

/* Share sheet */
.share-mask{position:fixed;inset:0;background:rgba(0,0,0,0.5);display:flex;align-items:flex-end;justify-content:center;z-index:200}
.share-sheet{background:#1a1a2e;border-radius:28rpx 28rpx 0 0;padding:12rpx 32rpx 56rpx;width:100%;max-height:85vh;overflow-y:auto}
.sheet-handle{width:48rpx;height:5rpx;background:rgba(255,255,255,0.15);border-radius:3rpx;margin:12rpx auto 24rpx}
.share-title{display:block;font-size:32rpx;font-weight:600;color:#f5f5f7;text-align:center;margin-bottom:28rpx}
.rel-list{display:flex;flex-wrap:wrap;gap:14rpx;margin-bottom:32rpx}
.rel-item{flex:0 0 calc(33.33% - 10rpx);display:flex;flex-direction:column;align-items:center;
  padding:28rpx 0;background:rgba(255,255,255,0.04);border-radius:16rpx;border:2rpx solid transparent}
.rel-item.active{border-color:#a29bfe;background:rgba(108,92,231,0.15)}
.rel-icon{width:64rpx;height:64rpx;border-radius:50%;background:rgba(108,92,231,0.15);
  display:flex;align-items:center;justify-content:center;margin-bottom:8rpx;
  transition:background 200ms ease-out}
.rel-item.active .rel-icon{background:rgba(162,155,254,0.28)}
.rel-icon-text{font-size:28rpx;font-weight:700;color:#c9bdff}
.rel-label{font-size:24rpx;color:#a8a8b8}
.privacy-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;
  background:rgba(255,255,255,0.04);border:1rpx solid rgba(255,255,255,0.08);
  border-radius:16rpx;padding:24rpx;margin-bottom:28rpx}
.privacy-copy{flex:1}
.privacy-title{display:block;font-size:27rpx;font-weight:600;color:#f5f5f7;margin-bottom:8rpx}
.privacy-desc{display:block;font-size:22rpx;color:#a8a8b8;line-height:1.5}
.btn-cancel{width:100%;background:transparent;color:#a8a8b8;font-size:28rpx;margin-top:16rpx;padding:20rpx 0;min-height:88rpx}
.btn-cancel::after{border:none}

/* Result sheet */
.result-sheet{text-align:center}
.result-title{font-size:34rpx;font-weight:600;color:#f5f5f7;display:block;margin-bottom:24rpx;padding-top:8rpx}
.code-display{background:rgba(108,92,231,0.15);border:2rpx dashed rgba(162,155,254,0.3);
  border-radius:16rpx;padding:28rpx;margin-bottom:16rpx}
.code-text{font-size:48rpx;font-weight:800;color:#a29bfe;letter-spacing:10rpx}
.code-hint{font-size:24rpx;color:#a8a8b8;display:block;margin-bottom:28rpx;padding:0 24rpx}
.result-actions{display:flex;gap:16rpx}
.btn-outline-sm{flex:1;background:transparent;color:#a29bfe;border:2rpx solid #a29bfe;border-radius:40rpx;
  padding:20rpx 0;font-size:26rpx}
.btn-primary-sm{flex:1;background:linear-gradient(135deg,#6c5ce7,#a29bfe);color:#fff;border-radius:40rpx;
  padding:20rpx 0;font-size:26rpx;border:none}
.btn-outline-sm::after,.btn-primary-sm::after{border:none}

/* Overlay */
.spinner{width:48rpx;height:48rpx;border:4rpx solid rgba(255,255,255,0.1);border-top-color:#a29bfe;
  border-radius:50%;animation:spin 0.8s linear infinite;margin:0 auto 24rpx}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-text{font-size:28rpx;color:#a29bfe;display:block;text-align:center}
.loading-wrap{padding:160rpx 0;text-align:center}

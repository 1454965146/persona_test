.brand-area{text-align:center;padding:56rpx 0 24rpx}
.brand-mark{width:100rpx;height:100rpx;margin:0 auto 20rpx;position:relative;border-radius:50%;overflow:hidden;
  background:linear-gradient(135deg,#6c5ce7,#a29bfe);animation:brandPulse 3s ease-in-out infinite}
@keyframes brandPulse{0%,100%{box-shadow:0 0 0 0 rgba(108,92,231,0.4)}50%{box-shadow:0 0 0 16rpx rgba(108,92,231,0)}}
.brand-mask-left{position:absolute;top:0;left:0;width:50%;height:100%;background:rgba(15,15,26,0.5)}
.brand-mask-right{position:absolute;top:0;right:0;width:50%;height:100%;background:rgba(15,15,26,0.3)}
.brand-dot{position:absolute;width:10rpx;height:10rpx;border-radius:50%;background:#fff}
.brand-dot-1{top:28rpx;left:45rpx}.brand-dot-2{bottom:32rpx;left:30rpx}.brand-dot-3{bottom:32rpx;right:30rpx}
.brand-title{display:block;font-size:44rpx;font-weight:700;color:#f5f5f7;letter-spacing:6rpx}
.brand-subtitle{display:block;font-size:24rpx;color:#a8a8b8;margin-top:8rpx}

.stats-row{display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.04);
  border-radius:16rpx;padding:24rpx 12rpx;margin:24rpx 0}
.stat-item{flex:1;text-align:center}
.stat-value{display:block;font-size:32rpx;font-weight:700;color:#a29bfe}
.stat-label{display:block;font-size:22rpx;color:#a8a8b8;margin-top:4rpx}
.stat-divider{width:1rpx;height:36rpx;background:rgba(255,255,255,0.08)}

.login-card{background:rgba(255,255,255,0.04);border:1rpx solid rgba(255,255,255,0.06);
  border-radius:20rpx;padding:32rpx 28rpx}
.login-title{display:block;font-size:30rpx;font-weight:600;color:#f5f5f7;margin-bottom:8rpx}
.login-desc{display:block;font-size:24rpx;color:#a8a8b8;margin-bottom:24rpx}

.input-group{margin-bottom:24rpx}
.input-label{display:block;font-size:22rpx;color:#a8a8b8;letter-spacing:2rpx;margin-bottom:10rpx}
.input-field{background:rgba(255,255,255,0.06);border:2rpx solid rgba(255,255,255,0.08);
  border-radius:14rpx;padding:26rpx 20rpx;color:#f0f0f5;font-size:28rpx;text-align:center;
  min-height:84rpx;box-sizing:border-box}
.input-field:focus{border-color:#6c5ce7}
.invite-input{font-family:monospace;letter-spacing:3rpx;font-size:30rpx}
.input-placeholder{color:#7a7a8a}
.input-hint{display:block;font-size:22rpx;color:#a29bfe;margin-top:8rpx;text-align:center}
.input-hint.error{color:#ff6b6b}

.hint-text{display:block;text-align:center;font-size:22rpx;color:#7a7a8a;margin-top:20rpx}

.footer-links{margin-top:32rpx}
.history-link{display:flex;align-items:center;justify-content:center;gap:8rpx;
  padding:24rpx;min-height:80rpx;transition:opacity 200ms ease-out}
.history-link:active{opacity:0.7}
.history-link text{font-size:26rpx;color:#a29bfe}
.history-arrow{font-size:22rpx}
.logout-link{display:flex;align-items:center;justify-content:center;
  padding:20rpx;min-height:72rpx;transition:opacity 200ms ease-out}
.logout-link:active{opacity:0.7}
.logout-link text{font-size:22rpx;color:#a8a8b8}

/* Login Modal */
.modal-mask{position:fixed;inset:0;background:rgba(0,0,0,0.55);display:flex;
  align-items:center;justify-content:center;z-index:300;padding:32rpx}
.modal-sheet{background:#1a1a2e;border-radius:24rpx;padding:40rpx 32rpx 32rpx;width:100%;max-width:560rpx}
.modal-title{display:block;font-size:34rpx;font-weight:700;color:#f5f5f7;text-align:center;margin-bottom:32rpx}
.modal-error{display:block;font-size:24rpx;color:#ff6b6b;text-align:center;margin-bottom:16rpx}
.modal-switch{text-align:center;padding:24rpx 0;transition:opacity 200ms ease-out}
.modal-switch:active{opacity:0.7}
.modal-switch text{font-size:24rpx;color:#a29bfe}
.btn-cancel{width:100%;background:transparent;color:#a8a8b8;font-size:26rpx;margin-top:12rpx;padding:16rpx 0;min-height:88rpx}
.btn-cancel::after{border:none}
